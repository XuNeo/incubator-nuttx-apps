#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_T113_TEST
	tristate "T113 hardware integration test"
	default n
	---help---
		Enable the T113 hardware integration test suite.
		Tests MTD erase/write/read, LittleFS mount/file I/O,
		and CLOCK_MONOTONIC timer functionality.

if EXAMPLES_T113_TEST

config EXAMPLES_T113_TEST_PROGNAME
	string "Program name"
	default "t113_test"
	---help---
		This is the name of the program that will be used when the
		NSH ELF program is installed.

config EXAMPLES_T113_TEST_PRIORITY
	int "T113 test task priority"
	default 100

config EXAMPLES_T113_TEST_STACKSIZE
	int "T113 test stack size"
	default DEFAULT_TASK_STACKSIZE

endif
